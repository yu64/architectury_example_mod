{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Minecraft Client (:neoforge)",
      "request": "attach",
      "preLaunchTask": "DebugClient_NeoForge",
      "hostName": "localhost",
      "port": 5005,
      "timeout": 100000
    },
    {
      "type": "java",
      "name": "Minecraft Server (:neoforge)",
      "request": "attach",
      "preLaunchTask": "DebugServer_NeoForge",
      "hostName": "localhost",
      "port": 5005,
      "timeout": 100000
    },
    {
      "type": "java",
      "name": "Minecraft Client (:fabric)",
      "request": "launch",
      "cwd": "${workspaceFolder}/fabric/run",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "mainClass": "dev.architectury.transformer.TransformerRuntime",
      "vmArgs": "-Dfabric.dli.config\u003d${workspaceFolder}\\fabric\\.gradle\\loom-cache\\launch.cfg -Dfabric.dli.env\u003dclient -Dfabric.dli.main\u003dnet.fabricmc.loader.impl.launch.knot.KnotClient -Darchitectury.main.class\u003d${workspaceFolder}\\fabric\\.gradle\\architectury\\.main_class -Darchitectury.runtime.transformer\u003d${workspaceFolder}\\fabric\\.gradle\\architectury\\.transforms -Darchitectury.properties\u003d${workspaceFolder}\\fabric\\.gradle\\architectury\\.properties -Djdk.attach.allowAttachSelf\u003dtrue -javaagent:${workspaceFolder}\\.gradle\\architectury\\architectury-transformer-agent.jar",
      "args": "",
      "env": {},
      "projectName": "fabric"
    },
    {
      "type": "java",
      "name": "Minecraft Server (:fabric)",
      "request": "launch",
      "cwd": "${workspaceFolder}/fabric/run",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "mainClass": "dev.architectury.transformer.TransformerRuntime",
      "vmArgs": "-Dfabric.dli.config\u003d${workspaceFolder}\\fabric\\.gradle\\loom-cache\\launch.cfg -Dfabric.dli.env\u003dserver -Dfabric.dli.main\u003dnet.fabricmc.loader.impl.launch.knot.KnotServer -Darchitectury.main.class\u003d${workspaceFolder}\\fabric\\.gradle\\architectury\\.main_class -Darchitectury.runtime.transformer\u003d${workspaceFolder}\\fabric\\.gradle\\architectury\\.transforms -Darchitectury.properties\u003d${workspaceFolder}\\fabric\\.gradle\\architectury\\.properties -Djdk.attach.allowAttachSelf\u003dtrue -javaagent:${workspaceFolder}\\.gradle\\architectury\\architectury-transformer-agent.jar",
      "args": "nogui",
      "env": {},
      "projectName": "fabric"
    },
    {
      "type": "java",
      "name": "Minecraft Client (:quilt)",
      "request": "launch",
      "cwd": "${workspaceFolder}/quilt/run",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "mainClass": "dev.architectury.transformer.TransformerRuntime",
      "vmArgs": "-Dfabric.dli.config\u003d${workspaceFolder}\\quilt\\.gradle\\loom-cache\\launch.cfg -Dfabric.dli.env\u003dclient -Dfabric.dli.main\u003dorg.quiltmc.loader.impl.launch.knot.KnotClient -Darchitectury.main.class\u003d${workspaceFolder}\\quilt\\.gradle\\architectury\\.main_class -Darchitectury.runtime.transformer\u003d${workspaceFolder}\\quilt\\.gradle\\architectury\\.transforms -Darchitectury.properties\u003d${workspaceFolder}\\quilt\\.gradle\\architectury\\.properties -Djdk.attach.allowAttachSelf\u003dtrue -javaagent:${workspaceFolder}\\.gradle\\architectury\\architectury-transformer-agent.jar",
      "args": "",
      "env": {},
      "projectName": "quilt"
    },
    {
      "type": "java",
      "name": "Minecraft Server (:quilt)",
      "request": "launch",
      "cwd": "${workspaceFolder}/quilt/run",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "mainClass": "dev.architectury.transformer.TransformerRuntime",
      "vmArgs": "-Dfabric.dli.config\u003d${workspaceFolder}\\quilt\\.gradle\\loom-cache\\launch.cfg -Dfabric.dli.env\u003dserver -Dfabric.dli.main\u003dorg.quiltmc.loader.impl.launch.knot.KnotServer -Darchitectury.main.class\u003d${workspaceFolder}\\quilt\\.gradle\\architectury\\.main_class -Darchitectury.runtime.transformer\u003d${workspaceFolder}\\quilt\\.gradle\\architectury\\.transforms -Darchitectury.properties\u003d${workspaceFolder}\\quilt\\.gradle\\architectury\\.properties -Djdk.attach.allowAttachSelf\u003dtrue -javaagent:${workspaceFolder}\\.gradle\\architectury\\architectury-transformer-agent.jar",
      "args": "nogui",
      "env": {},
      "projectName": "quilt"
    }
  ]
}